APP_NAME="LP Furniture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=furniture_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Idle logout for the admin guard — a separate mechanism from
# SESSION_LIFETIME above (which now also governs customer sessions
# at the same 30-minute idle cutoff), kept distinct because the two
# guards' timeouts are allowed to diverge again later without
# touching each other.
ADMIN_SESSION_TIMEOUT=30

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="LP Furniture"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Real GCash payments via PayMongo (test mode: pk_test_/sk_test_).
# PAYMONGO_WEBHOOK_SECRET comes from registering a webhook endpoint
# in the PayMongo dashboard (Developers > Webhooks) — needs a
# publicly reachable HTTPS URL, so this can only be set up once
# deployed/tunneled, not on a bare local XAMPP install.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
DEEPAI_API_KEY=
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"